---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_URL } from '../consts';
---

<BaseLayout
	title={`Contacto | ${SITE_TITLE}`}
	description="Contacto Trucos125: consultas técnicas, colaboraciones y comunidad de restauradores y mecánica clásica."
>
	<article class="contact-page">
		<section class="contact-intro" aria-labelledby="contact-heading">
			<p class="badge">Comunidad</p>
			<h1 id="contact-heading">Hablemos de taller</h1>
			<p class="intro-text">
				¿Propuesta editorial, datos de una variante de motor o una duda que no encaja en los foros? Aquí
				escribimos con ustedes: mecánica clásica, restauración y el archivo vivo del sedán que ha mantenido
				latinoamérica y europa en ruta durante décadas. Si aporta fotos o números de bastidor, mejor; si no,
				igual leemos con atención.
			</p>
			<div class="info-item">
				<strong>Correo directo</strong>
				<p><a href="mailto:hola@trucos125.com">hola@trucos125.com</a></p>
			</div>
			<div class="info-item">
				<strong>Redes</strong>
				<div class="social-icons">
					<a href="https://instagram.com/trucos125_" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
					</a>
					<a href="https://www.facebook.com/profile.php?id=61582252036670" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
					</a>
					<a href="https://x.com/Trucos125" target="_blank" rel="noopener noreferrer" aria-label="X">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l11.733 16h4.267l-11.733 -16z"></path><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"></path></svg>
					</a>
					<a href="https://youtube.com/@Trucos125" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
					</a>
				</div>
			</div>
		</section>

		<section class="contact-form-section" aria-labelledby="form-heading">
			<h2 id="form-heading" class="visually-hidden">Formulario de contacto</h2>
			<div class="contact-form-card">
				<form
					class="form"
					action="https://api.web3forms.com/submit"
					method="POST"
					aria-describedby="form-hint privacy-consent-label"
				>
					<input type="hidden" name="access_key" value="9c03786c-6fd9-4e7c-9ad6-62f33fd5ceba" />
					<input type="hidden" name="subject" value="Nuevo mensaje desde la web Trucos125" />
					<input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" />

					<p id="form-hint" class="form-hint">
						Campos obligatorios marcados con el atributo requerido; use un correo real si espera respuesta.
					</p>

					<fieldset class="fieldset">
						<legend class="legend">Datos de contacto</legend>
						<div class="form-group">
							<label for="contact-name">Nombre o taller</label>
							<input
								id="contact-name"
								type="text"
								name="name"
								autocomplete="name"
								placeholder="Ej. Taller Delta / Ana Gómez"
								required
								minlength="2"
							/>
						</div>
						<div class="form-group">
							<label for="contact-email">Correo electrónico</label>
							<input
								id="contact-email"
								type="email"
								name="email"
								autocomplete="email"
								placeholder="tu@email.com"
								required
							/>
						</div>
					</fieldset>

					<fieldset class="fieldset">
						<legend class="legend">Mensaje</legend>
						<div class="form-group">
							<label for="contact-message">Consulta o propuesta</label>
							<textarea
								id="contact-message"
								name="message"
								rows="6"
								placeholder="Contexto del vehículo, síntomas, lo que ya probó…"
								required
								minlength="20"
								aria-describedby="form-hint"
							></textarea>
						</div>
					</fieldset>

					<div class="form-consent">
						<input id="contact-privacy" type="checkbox" name="privacy_ok" value="yes" required />
						<label id="privacy-consent-label" for="contact-privacy">
							He leído la
							<a href={`${SITE_URL}/privacidad`} target="_blank" rel="noopener noreferrer"
								>política de privacidad</a
							>
							y consiento el tratamiento de mis datos para responder esta consulta.
						</label>
					</div>

					<button type="submit" class="btn-send">Enviar mensaje</button>
				</form>
			</div>
		</section>
	</article>
</BaseLayout>

<style>
	.contact-page {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: start;
		max-width: 1100px;
		margin: 0 auto;
	}
	.badge {
		display: inline-block;
		background: #111;
		color: #fff;
		padding: 0.35rem 0.75rem;
		font-weight: 800;
		text-transform: uppercase;
		font-size: 0.8rem;
		border-radius: 4px;
		margin-bottom: 0.75rem;
		font-family: var(--font-title);
	}
	.contact-intro h1 {
		font-family: var(--font-title);
		font-size: clamp(2.2rem, 4vw, 3.2rem);
		font-weight: 900;
		line-height: 1.05;
		margin: 0 0 1rem 0;
	}
	.intro-text {
		font-size: 1.1rem;
		line-height: 1.7;
		color: #444;
		margin: 0 0 1.5rem 0;
	}
	.info-item {
		margin-top: 1.5rem;
	}
	.info-item strong {
		display: block;
		font-family: var(--font-title);
		font-size: 1rem;
		color: #e30613;
		margin-bottom: 0.35rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	.info-item p {
		margin: 0;
		font-size: 1.15rem;
		font-weight: 600;
	}
	.social-icons {
		display: flex;
		gap: 12px;
		margin-top: 0.5rem;
	}
	.social-icons a {
		color: #111;
		transition: color 0.2s ease, transform 0.2s ease;
	}
	.social-icons a:hover {
		color: #e30613;
		transform: translateY(-2px);
	}
	.contact-form-card {
		background: #f9fafb;
		padding: 2rem;
		border-radius: 16px;
		border: 1px solid #eee;
		box-shadow: 0 12px 36px rgba(0, 0, 0, 0.06);
	}
	.form-hint {
		font-size: 0.9rem;
		color: #666;
		margin: 0 0 1.25rem 0;
	}
	.fieldset {
		border: none;
		margin: 0 0 1.25rem 0;
		padding: 0;
	}
	.legend {
		font-family: var(--font-title);
		font-weight: 800;
		font-size: 1rem;
		text-transform: uppercase;
		margin-bottom: 1rem;
		padding: 0;
	}
	.form-group {
		margin-bottom: 1rem;
	}
	.form-group label {
		display: block;
		font-weight: 700;
		margin-bottom: 0.35rem;
		font-family: var(--font-title);
		font-size: 0.95rem;
	}
	input,
	textarea {
		width: 100%;
		padding: 12px 14px;
		border: 1px solid #ddd;
		border-radius: 8px;
		font-size: 1rem;
		font-family: inherit;
		box-sizing: border-box;
	}
	input:focus,
	textarea:focus {
		outline: none;
		border-color: #e30613;
		box-shadow: 0 0 0 3px rgba(227, 6, 19, 0.15);
	}
	.form-consent {
		display: flex;
		gap: 10px;
		align-items: flex-start;
		margin: 1.25rem 0;
		font-size: 0.95rem;
		line-height: 1.45;
		color: #333;
	}
	.form-consent input {
		width: auto;
		margin-top: 4px;
		flex-shrink: 0;
	}
	.btn-send {
		width: 100%;
		background: #e30613;
		color: #fff;
		border: none;
		padding: 15px;
		font-family: var(--font-title);
		font-size: 1.15rem;
		font-weight: 800;
		cursor: pointer;
		border-radius: 8px;
		transition: background 0.2s, transform 0.2s;
	}
	.btn-send:hover {
		background: #be123c;
		transform: translateY(-1px);
	}
	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
	@media (max-width: 768px) {
		.contact-page {
			grid-template-columns: 1fr;
		}
		.contact-form-card {
			padding: 1.5rem;
		}
	}
</style>
